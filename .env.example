# ==============================================================================
# FLATEL HOSPITALITY — ENVIRONMENT VARIABLES CONFIGURATION
# Copy this file to `.env.local` and populate your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Database, Auth, Server-side Admin)
# ------------------------------------------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://mguwtlcgloiktfeuwlws.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service role secret (Server-side ONLY, never expose to client!)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Internal Server Admin Secret (Used for protecting server-side admin endpoints)
ADMIN_SECRET_KEY=generate_a_random_32_character_admin_secret_key_here

# ------------------------------------------------------------------------------
# 2. RAZORPAY (Payment Gateway)
# ------------------------------------------------------------------------------
# Found in: Razorpay Dashboard -> Settings -> API Keys
# (If left empty, system automatically operates in interactive Sandbox Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay Webhook Secret (Dashboard -> Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# 3. CLOUDFLARE R2 OBJECT STORAGE (Optional: for cloud image uploads)
# ------------------------------------------------------------------------------
# (If not configured, images will continue loading from local public/images)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=flatel-images
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-f471c3e24db144a6a94c290eececee02.r2.dev

# ------------------------------------------------------------------------------
# 4. BUSINESS & WHATSAPP CONCIERGE (Optional: has built-in defaults)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=+91 7989100711
